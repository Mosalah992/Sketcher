{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "io.github.sepiasketcher",
  "applicationName": "Sepia Sketcher",
  "author": "Bruma Joint Archives",
  "description": "Turns pictures into sepia pencil sketches on aged paper.",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "injectGlobals": true,
  "logging": {
    "enabled": false,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "app.exit",
    "os.showSaveDialog",
    "os.showFolderDialog",
    "os.open",
    "filesystem.writeBinaryFile",
    "filesystem.getStats"
  ],
  "modes": {
    "window": {
      "title": "Sepia Sketcher",
      "width": 1100,
      "height": 780,
      "minWidth": 560,
      "minHeight": 520,
      "center": true,
      "icon": "/resources/icons/appIcon.png",
      "enableInspector": false,
      "resizable": true,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "SepiaSketcher",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.10.0",
    "clientVersion": "6.10.0"
  }
}
